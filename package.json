    "configuration": {
      "title": "LoreDock",
      "properties": {
        "loredock.ai.provider": {
          "type": "string",
          "default": "openai-compatible",
          "enum": [
            "openai-compatible",
            "openrouter",
            "lm-studio",
            "ollama",
            "deepseek",
            "custom"
          ],
          "description": "AI provider profile. All profiles use an OpenAI-compatible chat completions API."
        },
        "loredock.ai.baseUrl": {
          "type": "string",
          "default": "http://localhost:1234/v1",
          "description": "Base URL for the OpenAI-compatible API, without /chat/completions."
        },
        "loredock.ai.model": {
          "type": "string",
          "default": "",
          "description": "Model name sent to the AI provider."
        },
        "loredock.ai.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Default sampling temperature."
        },
        "loredock.ai.maxOutputTokens": {
          "type": "number",
          "default": 1200,
          "minimum": 128,
          "maximum": 16000,
          "description": "Maximum generated tokens for AI writing tasks."
        },
        "loredock.ai.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 5000,
          "maximum": 600000,
          "description": "AI request timeout in milliseconds."
        },
        "loredock.ai.defaultLanguage": {
          "type": "string",
          "default": "zh-CN",
          "description": "Default language for AI writing tasks."
        }
      }
    }
  }
}
