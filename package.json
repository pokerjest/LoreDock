{
  "name": "loredock",
  "displayName": "LoreDock",
  "description": "面向 VS Code 的本地优先故事项目系统。",
  "version": "0.3.0",
  "publisher": "loredock",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.loredock/project.json",
    "onCommand:loredock.initProject",
    "onCommand:loredock.openProjectManifest",
    "onCommand:loredock.showDiagnostics",
    "onCommand:loredock.repairProjectManifest",
    "onCommand:loredock.enableManuscript",
    "onCommand:loredock.manuscript.createBook",
    "onCommand:loredock.manuscript.switchBook",
    "onCommand:loredock.manuscript.openBookProject",
    "onCommand:loredock.manuscript.deleteBookProject",
    "onCommand:loredock.manuscript.refreshBookAgentGuide",
    "onCommand:loredock.enableStoryBible",
    "onCommand:loredock.storyBible.openGallery",
    "onCommand:loredock.storyBible.createCard",
    "onCommand:loredock.storyBible.searchCards",
    "onCommand:loredock.storyBible.defineKeyword",
    "onCommand:loredock.enableOutlineScenes",
    "onCommand:loredock.outlineScenes.createOutline",
    "onCommand:loredock.outlineScenes.deleteOutline",
    "onCommand:loredock.outlineScenes.importOutline",
    "onCommand:loredock.outlineScenes.createSceneCard",
    "onCommand:loredock.outlineScenes.createSceneCardFromChapter",
    "onCommand:loredock.outlineScenes.bindScenesToChapter",
    "onCommand:loredock.outlineScenes.bindSceneToChapters",
    "onCommand:loredock.outlineScenes.createChapterAndBindScene",
    "onCommand:loredock.outlineScenes.openSceneCard",
    "onCommand:loredock.outlineScenes.editSceneMetadata",
    "onCommand:loredock.outlineScenes.deleteSceneCard",
    "onCommand:loredock.outlineScenes.restoreTrashItem",
    "onCommand:loredock.outlineScenes.permanentlyDeleteTrashItem",
    "onCommand:loredock.outlineScenes.refreshTree",
    "onCommand:loredock.outlineScenes.toggleTrash",
    "onView:loredock.manuscript.tree",
    "onView:loredock.storyBible.tree",
    "onView:loredock.outlineScenes.tree"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "loredock.initProject",
        "title": "LoreDock：初始化项目",
        "icon": "$(rocket)"
      },
      {
        "command": "loredock.openProjectManifest",
        "title": "LoreDock：打开项目清单",
        "icon": "$(json)"
      },
      {
        "command": "loredock.showDiagnostics",
        "title": "LoreDock：显示诊断",
        "icon": "$(warning)"
      },
      {
        "command": "loredock.repairProjectManifest",
        "title": "LoreDock：修复项目清单",
        "icon": "$(tools)"
      },
      {
        "command": "loredock.enableManuscript",
        "title": "LoreDock：启用手稿",
        "icon": "$(add)"
      },
      {
        "command": "loredock.manuscript.createBook",
        "title": "LoreDock：新建书籍项目",
        "icon": "$(new-folder)"
      },
      {
        "command": "loredock.manuscript.switchBook",
        "title": "LoreDock：切换书籍",
        "icon": "$(folder-opened)"
      },
      {
        "command": "loredock.manuscript.openBookProject",
        "title": "LoreDock：打开书籍项目",
        "icon": "$(folder-opened)"
      },
      {
        "command": "loredock.manuscript.deleteBookProject",
        "title": "LoreDock：删除书籍项目",
        "icon": "$(trash)"
      },
      {
        "command": "loredock.manuscript.createVolume",
        "title": "LoreDock：新建卷",
        "icon": "$(add)"
      },
      {
        "command": "loredock.manuscript.createChapter",
        "title": "LoreDock：新建章节",
        "icon": "$(new-file)"
      },
      {
        "command": "loredock.manuscript.openChapter",
        "title": "LoreDock：打开章节",
        "icon": "$(go-to-file)"
      },
      {
        "command": "loredock.manuscript.renameBook",
        "title": "LoreDock：重命名书籍"
      },
      {
        "command": "loredock.manuscript.refreshBookAgentGuide",
        "title": "LoreDock：刷新书籍 AI 指南",
        "icon": "$(tools)"
      },
      {
        "command": "loredock.manuscript.renameVolume",
        "title": "LoreDock：重命名卷",
        "icon": "$(edit)"
      },
      {
        "command": "loredock.manuscript.renameChapter",
        "title": "LoreDock：重命名章节",
        "icon": "$(edit)"
      },
      {
        "command": "loredock.manuscript.moveChapter",
        "title": "LoreDock：移动章节"
      },
      {
        "command": "loredock.manuscript.moveChapterUp",
        "title": "LoreDock：上移章节",
        "icon": "$(arrow-up)"
      },
      {
        "command": "loredock.manuscript.moveChapterDown",
        "title": "LoreDock：下移章节",
        "icon": "$(arrow-down)"
      },
      {
        "command": "loredock.manuscript.deleteVolume",
        "title": "LoreDock：删除卷",
        "icon": "$(trash)"
      },
      {
        "command": "loredock.manuscript.deleteChapter",
        "title": "LoreDock：删除章节",
        "icon": "$(trash)"
      },
      {
        "command": "loredock.manuscript.restoreTrashItem",
        "title": "LoreDock：还原回收站项目",
        "icon": "$(history)"
      },
      {
        "command": "loredock.manuscript.permanentlyDeleteTrashItem",
        "title": "LoreDock：永久删除回收站项目",
        "icon": "$(trash)"
      },
      {
        "command": "loredock.manuscript.setChapterStatus",
        "title": "LoreDock：设置章节状态"
      },
      {
        "command": "loredock.manuscript.setChapterTargetWordCount",
        "title": "LoreDock：设置章节目标字数"
      },
      {
        "command": "loredock.manuscript.refreshTree",
        "title": "LoreDock：刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "loredock.manuscript.toggleTrash",
        "title": "LoreDock：切换回收站",
        "icon": "$(trash)"
      },
      {
        "command": "loredock.manuscript.openNotes",
        "title": "LoreDock：打开笔记",
        "icon": "$(notebook)"
      },
      {
        "command": "loredock.manuscript.showStats",
        "title": "LoreDock：手稿统计",
        "icon": "$(graph)"
      },
      {
        "command": "loredock.enableStoryBible",
        "title": "LoreDock：启用故事圣经",
        "icon": "$(add)"
      },
      {
        "command": "loredock.storyBible.openGallery",
        "title": "LoreDock：打开故事圣经条目库",
        "icon": "$(preview)"
      },
      {
        "command": "loredock.storyBible.createCard",
        "title": "LoreDock：新建故事圣经条目",
        "icon": "$(new-file)"
      },
      {
        "command": "loredock.storyBible.createCharacter",
        "title": "LoreDock：新建人物",
        "icon": "$(person)"
      },
      {
        "command": "loredock.storyBible.createLocation",
        "title": "LoreDock：新建地点",
        "icon": "$(location)"
      },
      {
        "command": "loredock.storyBible.createRule",
        "title": "LoreDock：新建规则",
        "icon": "$(law)"
      },
      {
        "command": "loredock.storyBible.openCard",
        "title": "LoreDock：打开/编辑条目",
        "icon": "$(edit)"
      },
      {
        "command": "loredock.storyBible.renameCard",
        "title": "LoreDock：重命名条目",
        "icon": "$(edit)"
      },
      {
        "command": "loredock.storyBible.editCardMetadata",
        "title": "LoreDock：编辑条目元数据",
        "icon": "$(settings-gear)"
      },
      {
        "command": "loredock.storyBible.repairCardPrimaryKeyword",
        "title": "LoreDock：修复条目主关键词",
        "icon": "$(wrench)"
      },
      {
        "command": "loredock.storyBible.deleteCard",
        "title": "LoreDock：删除条目",
        "icon": "$(trash)"
      },
      {
        "command": "loredock.storyBible.searchCards",
        "title": "LoreDock：搜索故事圣经",
        "icon": "$(search)"
      },
      {
        "command": "loredock.storyBible.createCardFromSelection",
        "title": "LoreDock：从选中文本创建条目",
        "icon": "$(selection)"
      },
      {
        "command": "loredock.storyBible.browseKeywords",
        "title": "LoreDock：浏览关键词",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "loredock.storyBible.defineKeyword",
        "title": "LoreDock：定义关键词",
        "icon": "$(tag)"
      },
      {
        "command": "loredock.storyBible.openKeywordDefinition",
        "title": "LoreDock：打开关键词定义",
        "icon": "$(go-to-file)"
      },
      {
        "command": "loredock.storyBible.editKeywordDefinition",
        "title": "LoreDock：编辑关键词定义",
        "icon": "$(edit)"
      },
      {
        "command": "loredock.storyBible.deleteKeywordDefinition",
        "title": "LoreDock：删除关键词定义",
        "icon": "$(trash)"
      },
      {
        "command": "loredock.storyBible.restoreTrashItem",
        "title": "LoreDock：还原资源垃圾桶项目",
        "icon": "$(history)"
      },
      {
        "command": "loredock.storyBible.permanentlyDeleteTrashItem",
        "title": "LoreDock：永久删除资源垃圾桶项目",
        "icon": "$(trash)"
      },
      {
        "command": "loredock.storyBible.refreshTree",
        "title": "LoreDock：刷新故事圣经",
        "icon": "$(refresh)"
      },
      {
        "command": "loredock.storyBible.toggleTrash",
        "title": "LoreDock：切换故事圣经资源垃圾桶",
        "icon": "$(trash)"
      },
      {
        "command": "loredock.enableOutlineScenes",
        "title": "LoreDock：启用结构规划",
        "icon": "$(add)"
      },
      {
        "command": "loredock.outlineScenes.createOutline",
        "title": "LoreDock：新建规划草稿",
        "icon": "$(new-file)"
      },
      {
        "command": "loredock.outlineScenes.deleteOutline",
        "title": "LoreDock：删除规划草稿",
        "icon": "$(trash)"
      },
      {
        "command": "loredock.outlineScenes.importOutline",
        "title": "LoreDock：预览导入大纲到结构骨架",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "loredock.outlineScenes.createSceneCard",
        "title": "LoreDock：新建场景卡",
        "icon": "$(symbol-event)"
      },
      {
        "command": "loredock.outlineScenes.createSceneCardFromChapter",
        "title": "LoreDock：新建场景卡并绑定此章节",
        "icon": "$(link)"
      },
      {
        "command": "loredock.outlineScenes.bindScenesToChapter",
        "title": "LoreDock：绑定已有场景卡到此章节",
        "icon": "$(link)"
      },
      {
        "command": "loredock.outlineScenes.bindSceneToChapters",
        "title": "LoreDock：绑定现有章节",
        "icon": "$(link)"
      },
      {
        "command": "loredock.outlineScenes.createChapterAndBindScene",
        "title": "LoreDock：新建章节并绑定",
        "icon": "$(new-file)"
      },
      {
        "command": "loredock.outlineScenes.openSceneCard",
        "title": "LoreDock：打开场景卡",
        "icon": "$(go-to-file)"
      },
      {
        "command": "loredock.outlineScenes.editSceneMetadata",
        "title": "LoreDock：编辑场景卡元数据",
        "icon": "$(settings-gear)"
      },
      {
        "command": "loredock.outlineScenes.deleteSceneCard",
        "title": "LoreDock：删除场景卡",
        "icon": "$(trash)"
      },
      {
        "command": "loredock.outlineScenes.restoreTrashItem",
        "title": "LoreDock：还原结构规划资源",
        "icon": "$(history)"
      },
      {
        "command": "loredock.outlineScenes.permanentlyDeleteTrashItem",
        "title": "LoreDock：永久删除结构规划资源",
        "icon": "$(trash)"
      },
      {
        "command": "loredock.outlineScenes.refreshTree",
        "title": "LoreDock：刷新结构规划",
        "icon": "$(refresh)"
      },
      {
        "command": "loredock.outlineScenes.toggleTrash",
        "title": "LoreDock：切换结构规划资源垃圾桶",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loredock",
          "title": "LoreDock",
          "icon": "resources/loredock.svg"
        }
      ]
    },
    "views": {
      "loredock": [
        {
          "id": "loredock.bookLibrary.tree",
          "name": "书库"
        },
        {
          "id": "loredock.manuscript.tree",
          "name": "手稿"
        },
        {
          "id": "loredock.storyBible.tree",
          "name": "故事圣经"
        },
        {
          "id": "loredock.outlineScenes.tree",
          "name": "结构规划"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "loredock.manuscript.createBook",
          "when": "view == loredock.bookLibrary.tree",
          "group": "navigation"
        },
        {
          "command": "loredock.manuscript.switchBook",
          "when": "view == loredock.bookLibrary.tree",
          "group": "navigation"
        },
        {
          "command": "loredock.manuscript.refreshTree",
          "when": "view == loredock.bookLibrary.tree",
          "group": "navigation"
        },
        {
          "command": "loredock.enableManuscript",
          "when": "view == loredock.manuscript.tree && !loredock.manuscript.active",
          "group": "navigation"
        },
        {
          "command": "loredock.manuscript.createVolume",
          "when": "view == loredock.manuscript.tree && loredock.manuscript.active && !loredock.manuscript.trashMode",
          "group": "navigation"
        },
        {
          "command": "loredock.manuscript.showStats",
          "when": "view == loredock.manuscript.tree && loredock.manuscript.active && !loredock.manuscript.trashMode",
          "group": "navigation"
        },
        {
          "command": "loredock.manuscript.toggleTrash",
          "when": "view == loredock.manuscript.tree && loredock.manuscript.active",
          "group": "navigation"
        },
        {
          "command": "loredock.manuscript.refreshTree",
          "when": "view == loredock.manuscript.tree",
          "group": "navigation"
        },
        {
          "command": "loredock.enableStoryBible",
          "when": "view == loredock.storyBible.tree && !loredock.storyBible.active",
          "group": "navigation"
        },
        {
          "command": "loredock.storyBible.openGallery",
          "when": "view == loredock.storyBible.tree && loredock.storyBible.active && !loredock.storyBible.trashMode",
          "group": "navigation"
        },
        {
          "command": "loredock.storyBible.createCard",
          "when": "view == loredock.storyBible.tree && loredock.storyBible.active && !loredock.storyBible.trashMode",
          "group": "navigation"
        },
        {
          "command": "loredock.storyBible.searchCards",
          "when": "view == loredock.storyBible.tree && loredock.storyBible.active && !loredock.storyBible.trashMode",
          "group": "navigation"
        },
        {
          "command": "loredock.storyBible.defineKeyword",
          "when": "view == loredock.storyBible.tree && loredock.storyBible.active && !loredock.storyBible.trashMode",
          "group": "navigation"
        },
        {
          "command": "loredock.storyBible.toggleTrash",
          "when": "view == loredock.storyBible.tree && loredock.storyBible.active",
          "group": "navigation"
        },
        {
          "command": "loredock.storyBible.refreshTree",
          "when": "view == loredock.storyBible.tree",
          "group": "navigation"
        },
        {
          "command": "loredock.enableOutlineScenes",
          "when": "view == loredock.outlineScenes.tree && !loredock.outlineScenes.active",
          "group": "navigation"
        },
        {
          "command": "loredock.outlineScenes.createOutline",
          "when": "view == loredock.outlineScenes.tree && loredock.outlineScenes.active && !loredock.outlineScenes.trashMode",
          "group": "navigation@1"
        },
        {
          "command": "loredock.outlineScenes.importOutline",
          "when": "view == loredock.outlineScenes.tree && loredock.outlineScenes.active && !loredock.outlineScenes.trashMode",
          "group": "navigation@2"
        },
        {
          "command": "loredock.outlineScenes.toggleTrash",
          "when": "view == loredock.outlineScenes.tree && loredock.outlineScenes.active",
          "group": "navigation@3"
        },
        {
          "command": "loredock.outlineScenes.refreshTree",
          "when": "view == loredock.outlineScenes.tree",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "loredock.manuscript.openBookProject",
          "when": "view == loredock.bookLibrary.tree && viewItem == loredock.manuscript.bookProject",
          "group": "inline"
        },
        {
          "command": "loredock.manuscript.deleteBookProject",
          "when": "view == loredock.bookLibrary.tree && viewItem == loredock.manuscript.bookProject",
          "group": "inline"
        },
        {
          "command": "loredock.manuscript.createVolume",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.book",
          "group": "inline"
        },
        {
          "command": "loredock.manuscript.renameBook",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.book"
        },
        {
          "command": "loredock.manuscript.refreshBookAgentGuide",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.book"
        },
        {
          "command": "loredock.manuscript.deleteBookProject",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.book"
        },
        {
          "command": "loredock.manuscript.createChapter",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.volume",
          "group": "inline"
        },
        {
          "command": "loredock.manuscript.renameVolume",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.volume"
        },
        {
          "command": "loredock.manuscript.deleteVolume",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.volume"
        },
        {
          "command": "loredock.manuscript.openChapter",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.chapter",
          "group": "inline"
        },
        {
          "command": "loredock.manuscript.renameChapter",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.chapter"
        },
        {
          "command": "loredock.manuscript.moveChapter",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.chapter"
        },
        {
          "command": "loredock.manuscript.moveChapterUp",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.chapter",
          "group": "inline@1"
        },
        {
          "command": "loredock.manuscript.moveChapterDown",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.chapter",
          "group": "inline@2"
        },
        {
          "command": "loredock.manuscript.deleteChapter",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.chapter"
        },
        {
          "command": "loredock.manuscript.restoreTrashItem",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.trashItem",
          "group": "inline"
        },
        {
          "command": "loredock.manuscript.permanentlyDeleteTrashItem",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.trashItem",
          "group": "inline@1"
        },
        {
          "command": "loredock.manuscript.setChapterStatus",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.chapter"
        },
        {
          "command": "loredock.manuscript.setChapterTargetWordCount",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.chapter"
        },
        {
          "command": "loredock.manuscript.openNotes",
          "when": "view == loredock.manuscript.tree && viewItem == loredock.manuscript.notes"
        },
        {
          "command": "loredock.storyBible.createCharacter",
          "when": "view == loredock.storyBible.tree && viewItem == loredock.storyBible.group.character",
          "group": "inline"
        },
        {
          "command": "loredock.storyBible.createLocation",
          "when": "view == loredock.storyBible.tree && viewItem == loredock.storyBible.group.location",
          "group": "inline"
        },
        {
          "command": "loredock.storyBible.createRule",
          "when": "view == loredock.storyBible.tree && viewItem == loredock.storyBible.group.rule",
          "group": "inline"
        },
        {
          "command": "loredock.storyBible.defineKeyword",
          "when": "view == loredock.storyBible.tree && viewItem == loredock.storyBible.group.keyword",
          "group": "inline"
        },
        {
          "command": "loredock.storyBible.openCard",
          "when": "view == loredock.storyBible.tree && viewItem == loredock.storyBible.card",
          "group": "inline"
        },
        {
          "command": "loredock.storyBible.renameCard",
          "when": "view == loredock.storyBible.tree && viewItem == loredock.storyBible.card"
        },
        {
          "command": "loredock.storyBible.editCardMetadata",
          "when": "view == loredock.storyBible.tree && viewItem == loredock.storyBible.card"
        },
        {
          "command": "loredock.storyBible.repairCardPrimaryKeyword",
          "when": "view == loredock.storyBible.tree && viewItem == loredock.storyBible.card"
        },
        {
          "command": "loredock.storyBible.deleteCard",
