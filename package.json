    "menus": {
      "view/title": [
        {
          "command": "loredock.openSettings",
          "when": "view == loredock.manuscript",
          "group": "navigation@0"
        },
        {
          "command": "loredock.showManuscriptActions",
          "when": "view == loredock.manuscript",
          "group": "navigation@1"
        },
        {
          "command": "loredock.refreshViews",
          "when": "view == loredock.manuscript",
          "group": "navigation@2"
        },
        {
          "command": "loredock.openSettings",
          "when": "view == loredock.codex",
          "group": "navigation@0"
        },
        {
          "command": "loredock.showCodexActions",
          "when": "view == loredock.codex",
          "group": "navigation@1"
        },
        {
          "command": "loredock.refreshViews",
          "when": "view == loredock.codex",
          "group": "navigation@2"
        },
        {
          "command": "loredock.refreshViews",
          "when": "view == loredock.outlines",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "loredock.createVolume",
          "when": "view == loredock.manuscript && viewItem == loredock.project",
          "group": "inline@1"
        },
        {
          "command": "loredock.deleteProject",
          "when": "view == loredock.manuscript && viewItem == loredock.project",
          "group": "4_delete@1"
        },
        {
          "command": "loredock.createChapter",
          "when": "view == loredock.manuscript && viewItem == loredock.volume",
          "group": "inline@1"
        },
        {
          "command": "loredock.deleteVolume",
          "when": "view == loredock.manuscript && viewItem == loredock.volume",
          "group": "4_delete@1"
        },
        {
          "command": "loredock.openChapter",
          "when": "view == loredock.manuscript && viewItem == loredock.chapter",
          "group": "inline@1"
        },
        {
          "command": "loredock.renameChapter",
          "when": "view == loredock.manuscript && viewItem == loredock.chapter",
          "group": "2_edit@1"
        },
        {
          "command": "loredock.setChapterStatus",
          "when": "view == loredock.manuscript && viewItem == loredock.chapter",
          "group": "2_edit@2"
        },
        {
          "command": "loredock.deleteChapter",
          "when": "view == loredock.manuscript && viewItem == loredock.chapter",
          "group": "2_edit@3"
        },
      {
        "command": "loredock.runLocalConsistencyCheck",
        "when": "view == loredock.manuscript && viewItem == loredock.chapter",
        "group": "3_check@1"
      },
        {
          "command": "loredock.openBlueprintForOutline",
          "when": "view == loredock.outlines && viewItem == loredock.outline",
          "group": "inline@1"
        },
        {
          "command": "loredock.openOutlineSource",
          "when": "view == loredock.outlines && viewItem == loredock.outline",
          "group": "2_open@1"
        },
        {
          "command": "loredock.renameOutline",
          "when": "view == loredock.outlines && viewItem == loredock.outline",
          "group": "2_edit@1"
        },
        {
          "command": "loredock.deleteOutline",
          "when": "view == loredock.outlines && viewItem == loredock.outline",
          "group": "4_delete@1"
        },
        {
          "command": "loredock.openCodexEntry",
          "when": "view == loredock.codex && viewItem == loredock.codexEntry",
          "group": "inline@1"
        },
        {
          "command": "loredock.editCodexEntryForm",
          "when": "view == loredock.codex && viewItem == loredock.codexEntry",
          "group": "2_edit@1"
        },
        {
          "command": "loredock.deleteCodexEntry",
          "when": "view == loredock.codex && viewItem == loredock.codexEntry",
          "group": "4_delete@1"
        },
        {
          "command": "loredock.createCharacter",
          "when": "view == loredock.codex && viewItem == loredock.characters",
          "group": "inline@1"
        },
        {
          "command": "loredock.createLocation",
          "when": "view == loredock.codex && viewItem == loredock.locations",
          "group": "inline@1"
        },
        {
          "command": "loredock.createWorldRule",
          "when": "view == loredock.codex && viewItem == loredock.worldRules",
          "group": "inline@1"
        },
        {
          "command": "loredock.createForeshadowing",
          "when": "view == loredock.codex && viewItem == loredock.foreshadowing",
          "group": "inline@1"
        },
        {
          "command": "loredock.showForeshadowingBoard",
          "when": "view == loredock.codex && viewItem == loredock.foreshadowing",
          "group": "2_view@1"
        },
        {
          "command": "loredock.createScene",
          "when": "view == loredock.codex && viewItem == loredock.scenes",
          "group": "inline@1"
        },
        {
          "command": "loredock.showSceneBeatBoard",
          "when": "view == loredock.codex && viewItem == loredock.scenes",
          "group": "2_view@1"
        },
        {
          "command": "loredock.normalizeSceneOrder",
          "when": "view == loredock.codex && viewItem == loredock.scenes",
          "group": "2_view@2"
        },
        {
          "command": "loredock.createBeat",
          "when": "view == loredock.codex && viewItem == loredock.beats",
          "group": "inline@1"
        },
        {
          "command": "loredock.showSceneBeatBoard",
          "when": "view == loredock.codex && viewItem == loredock.beats",
          "group": "2_view@1"
        },
        {
          "command": "loredock.normalizeBeatOrder",
          "when": "view == loredock.codex && viewItem == loredock.beats",
          "group": "2_view@2"
        }
