{
  "name": "loredock-vscode",
  "displayName": "LoreDock",
  "description": "Local-first writing workspace for long-form fiction structure.",
  "version": "0.2.0",
  "publisher": "pokerjest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pokerjest/LoreDock.git"
  },
  "bugs": {
    "url": "https://github.com/pokerjest/LoreDock/issues"
  },
  "homepage": "https://github.com/pokerjest/LoreDock#readme",
  "keywords": [
    "novel",
    "writing",
    "fiction",
    "loredock"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.loredock/project.json",
    "onView:loredock.manuscript",
    "onView:loredock.outlines",
    "onView:loredock.codex",
    "onCommand:loredock.initProject",
    "onCommand:loredock.openSettings",
    "onCommand:loredock.openPlanView",
    "onCommand:loredock.openBlueprintOutline",
    "onCommand:loredock.openTimelineWorkbench",
    "onCommand:loredock.openBlueprintForOutline",
    "onCommand:loredock.exportBlueprintMarkdown",
    "onCommand:loredock.importBlueprintMarkdown",
    "onCommand:loredock.previewBlueprintMarkdownSync",
    "onCommand:loredock.openOutlineSource",
    "onCommand:loredock.renameOutline",
    "onCommand:loredock.deleteOutline",
    "onCommand:loredock.importOutlineToPlan",
    "onCommand:loredock.rebuildReferenceIndex",
    "onCommand:loredock.showReferenceIndex",
    "onCommand:loredock.showProjectHealth",
    "onCommand:loredock.fixProjectHealth",
    "onCommand:loredock.exportCodexZip",
    "onCommand:loredock.importCodexZip",
    "onCommand:loredock.openStyleGuide",
    "onCommand:loredock.importManuscript",
    "onCommand:loredock.exportManuscript",
    "onCommand:loredock.showProjectDashboard",
    "onCommand:loredock.previewProjectHealthFixes",
    "onCommand:loredock.saveProjectHealthBaseline",
    "onCommand:loredock.clearProjectHealthBaseline"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && node ./out/test/runTest.js",
    "package:vsix": "vsce package --out loredock-vscode-0.2.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.5.3"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loredock",
          "title": "LoreDock",
          "icon": "resources/loredock.svg"
        }
      ]
    },
    "views": {
      "loredock": [
        {
          "id": "loredock.manuscript",
          "name": "手稿"
        },
        {
          "id": "loredock.outlines",
          "name": "大纲"
        },
        {
          "id": "loredock.codex",
          "name": "资料库"
        }
      ]
    },
    "commands": [
      {
        "command": "loredock.initProject",
        "title": "LoreDock: 初始化小说项目"
      },
      {
        "command": "loredock.refreshViews",
        "title": "LoreDock: 刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "loredock.openSettings",
        "title": "LoreDock: 设置",
        "icon": "$(gear)"
      },
      {
        "command": "loredock.showManuscriptActions",
        "title": "LoreDock: 手稿操作",
        "icon": "$(kebab-horizontal)"
      },
      {
        "command": "loredock.showCodexActions",
        "title": "LoreDock: 资料库操作",
        "icon": "$(kebab-horizontal)"
      },
      {
        "command": "loredock.createVolume",
        "title": "LoreDock: 新建卷"
      },
      {
        "command": "loredock.deleteProject",
