      },
      {
        "command": "loredock.openStyleGuide",
        "title": "LoreDock: 打开文风指南"
      },
      {
        "command": "loredock.configureExportStyle",
        "title": "LoreDock: 配置导出样式"
      },
      {
        "command": "loredock.setWritingGoals",
        "title": "LoreDock: 设置写作目标"
      },
      {
        "command": "loredock.importManuscript",
        "title": "LoreDock: 导入已有手稿"
      },
      {
        "command": "loredock.exportManuscript",
        "title": "LoreDock: 导出整本书"
